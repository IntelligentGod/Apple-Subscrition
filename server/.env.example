# Copy to .env and fill in. Never commit .env.

PORT=3000
DATABASE_URL="postgresql://eazee:eazee@localhost:5432/eazee"

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"

# Must match the iOS app and App Store Connect
APPLE_BUNDLE_ID="com.eazee.ai"
PRO_PRODUCT_IDS="com.eazee.subscription.pro.monthly"

# Numeric Apple ID of the app (App Store Connect → App Information → Apple ID).
# Required to verify Production transactions; optional for Sandbox.
APPLE_APP_APPLE_ID=""

# Folder with Apple's root certificates (.cer) — see README.
APPLE_ROOT_CERTS_DIR="./certs"

# Accept transactions signed by Xcode's local .storekit testing (never enable in production).
ALLOW_XCODE_TRANSACTIONS="true"
